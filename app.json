{
  "expo": {
    "name": "Komisio",
    "slug": "komisio",
    "owner": "chrillenilsson",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/komisio-icon.png",
    "scheme": ["komisio", "komisioapp"],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.inority.komisio",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/images/komisio-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aa98c8e5-440a-4860-92e1-829f6b3bc1a1"
      }
    },
    "android": {
      "package": "com.inority.komisio",
      "adaptiveIcon": {
        "backgroundColor": "#143E34",
        "foregroundImage": "./assets/images/komisio-foreground.png",
        "monochromeImage": "./assets/images/komisio-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/komisio-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/registeredstore.wav", "./assets/sounds/sale.wav"],
          "defaultChannel": "komisio-registered-v1",
          "color": "#143E34"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F5",
          "image": "./assets/images/komisio-splash.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
