# Copy to .env.local. Public client values only; never put a service key here.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Komisio portal origin: password reset and opt-in mobile seller command API.
# HTTPS in production; explicit HTTP loopback is accepted for local development.
# Browser tests also require this app's exact origin in the portal CORS allowlist.
EXPO_PUBLIC_KOMISIO_WEB_URL=http://localhost:3000
