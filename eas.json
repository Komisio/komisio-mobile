{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "android-play-internal": {
      "extends": "production",
      "android": { "buildType": "app-bundle" }
    },
    "screenshots": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "24.13.0",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "https://vpjpnqpkdejwzwpjjoon.supabase.co",
        "EXPO_PUBLIC_KOMISIO_WEB_URL": "https://app.komisio.com"
      }
    }
  },
  "submit": {
    "android-play-internal": {
      "android": { "track": "internal", "releaseStatus": "completed" }
    },
    "production": {
      "ios": {
        "ascAppId": "6753813071"
      }
    }
  }
}
